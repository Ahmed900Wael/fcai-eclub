{
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "htmlWhitespaceSensitivity": "css",
    "trailingComma": "all",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "plugins": [
        "prettier-plugin-tailwindcss"
    ],
    "overrides": [
        {
            "files": "*.css",
            "options": {
                "singleQuote": false
            }
        },
        {
            "files": "*.{ts,tsx}",
            "options": {
                "singleQuote": false
            }
        }
    ]
}
